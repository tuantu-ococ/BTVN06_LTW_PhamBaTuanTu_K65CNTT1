@model IEnumerable<Lesson7.Models.OrderBook>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccountId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReceiveAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReceivePhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderReceive)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Account)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderDetails)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.OrderDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.AccountId)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReceiveAddress)
            </td>
            <td>
                @Html.DisplayFor(model => item.ReceivePhone)
            </td>
            <td>
                @Html.DisplayFor(model => item.OrderReceive)
            </td>
            <td>
                @Html.DisplayFor(model => item.Note)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.Account)
            </td>
            <td>
                @Html.DisplayFor(model => item.OrderDetails)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OrderId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.OrderId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.OrderId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
